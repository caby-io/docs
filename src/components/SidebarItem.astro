---
import Icon from "./Icon.astro";
import { isGroup, type NavItem } from "../config/site";

interface Props {
  item: NavItem;
  currentPath: string;
}
const { item, currentPath } = Astro.props;

const norm = (p: string) => "/" + p.replace(/^\/+|\/+$/g, "");
const isActive = (link: string) => norm(link) === norm(currentPath);
const containsActive = (items: NavItem[]): boolean =>
  items.some((i) => (isGroup(i) ? containsActive(i.items) : isActive(i.link)));
---

{
  isGroup(item) ? (
    <details
      class="group"
      open={containsActive(item.items) || item.collapsed === false}
    >
      <summary>
        <span>{item.label}</span>
        <Icon name="right-caret" class="caret" />
      </summary>
      <ul>
        {item.items.map((child) => (
          <li>
            <Astro.self item={child} currentPath={currentPath} />
          </li>
        ))}
      </ul>
    </details>
  ) : (
    <a href={item.link} aria-current={isActive(item.link) ? "page" : undefined}>
      {item.label}
    </a>
  )
}

<style>
  a {
    display: flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
    line-height: 1.4;
  }
  a:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-6);
    text-decoration: none;
  }
  a[aria-current="page"] {
    color: var(--sl-color-text-accent);
    background-color: color-mix(
      in oklab,
      var(--sl-color-accent) 18%,
      transparent
    );
    font-weight: 500;
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: 0.375rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--sl-color-white);
  }
  .caret {
    flex-shrink: 0;
    width: 1rem;
    height: 1rem;
    transition: transform 0.2s ease;
  }
  .group[open] > summary .caret {
    transform: rotate(90deg);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    padding-inline-start: 0.5rem;
    margin-inline-start: 0.5rem;
    border-inline-start: 1px solid var(--clr-border);
  }
  li + li {
    margin-top: 0.1rem;
  }
</style>
