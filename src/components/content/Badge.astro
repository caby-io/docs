---
interface Props {
  text: string;
  variant?: "default" | "note" | "tip" | "success" | "caution" | "danger";
  size?: "small" | "medium" | "large";
}

const { text, variant = "default", size = "medium" } = Astro.props;
---

<span class="badge" data-variant={variant} data-size={size}>{text}</span>

<style>
  .badge {
    display: inline-block;
    border: 1px solid transparent;
    border-radius: 999px;
    font-family: var(--sl-font);
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }

  .badge[data-size="small"] {
    font-size: var(--sl-text-xs);
    padding: 0.0625rem 0.4rem;
  }
  .badge[data-size="medium"] {
    font-size: var(--sl-text-sm);
    padding: 0.125rem 0.5rem;
  }
  .badge[data-size="large"] {
    font-size: var(--sl-text-base);
    padding: 0.1875rem 0.625rem;
  }

  /* hue variants: -high text on a translucent hue fill + border. default is gray. */
  .badge[data-variant="default"] {
    color: var(--sl-color-gray-1);
    background-color: var(--sl-color-gray-5);
    border-color: var(--sl-color-gray-4);
  }
  .badge[data-variant="note"] {
    color: var(--sl-color-blue-high);
    background-color: color-mix(
      in oklab,
      var(--sl-color-blue) 15%,
      transparent
    );
    border-color: color-mix(in oklab, var(--sl-color-blue) 40%, transparent);
  }
  .badge[data-variant="tip"] {
    color: var(--sl-color-purple-high);
    background-color: color-mix(
      in oklab,
      var(--sl-color-purple) 15%,
      transparent
    );
    border-color: color-mix(in oklab, var(--sl-color-purple) 40%, transparent);
  }
  .badge[data-variant="success"] {
    color: var(--sl-color-green-high);
    background-color: color-mix(
      in oklab,
      var(--sl-color-green) 15%,
      transparent
    );
    border-color: color-mix(in oklab, var(--sl-color-green) 40%, transparent);
  }
  .badge[data-variant="caution"] {
    color: var(--sl-color-orange-high);
    background-color: color-mix(
      in oklab,
      var(--sl-color-orange) 15%,
      transparent
    );
    border-color: color-mix(in oklab, var(--sl-color-orange) 40%, transparent);
  }
  .badge[data-variant="danger"] {
    color: var(--sl-color-red-high);
    background-color: color-mix(in oklab, var(--sl-color-red) 15%, transparent);
    border-color: color-mix(in oklab, var(--sl-color-red) 40%, transparent);
  }
</style>
