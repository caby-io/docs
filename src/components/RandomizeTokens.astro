---
// swaps the example token placeholder for a fresh random 64-char token per load
// so visitors don't all copy the same one. no-js fallback is the placeholder text.
---

<script>
  const PLACEHOLDER = "REPLACE_WITH_A_UNIQUE_64_CHARACTER_TOKEN";
  const CHARS =
    "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";

  function randomToken(length = 64) {
    const values = crypto.getRandomValues(new Uint32Array(length));
    let token = "";
    for (let i = 0; i < length; i++) token += CHARS[values[i] % CHARS.length];
    return token;
  }

  function randomizeTokens() {
    // one token per load: a block's rendered text and its copy button must agree
    const token = randomToken();

    const walker = document.createTreeWalker(
      document.body,
      NodeFilter.SHOW_TEXT,
    );
    const targets = [];
    let node;
    while ((node = walker.nextNode())) {
      if (node.nodeValue && node.nodeValue.includes(PLACEHOLDER))
        targets.push(node);
    }
    for (const target of targets) {
      target.nodeValue = target.nodeValue.replaceAll(PLACEHOLDER, () => token);
    }

    // expressive-code's copy button holds its own payload, which the walker never visits
    for (const button of document.querySelectorAll("button[data-code]")) {
      const code = button.getAttribute("data-code");
      if (code?.includes(PLACEHOLDER))
        button.setAttribute(
          "data-code",
          code.replaceAll(PLACEHOLDER, () => token),
        );
    }
  }

  randomizeTokens();
  // re-run after client-side navigation, if view transitions are ever enabled
  document.addEventListener("astro:page-load", randomizeTokens);
</script>
