---
import { getCollection, render } from "astro:content";
import DocsLayout from "../layouts/DocsLayout.astro";
import SplashLayout from "../layouts/SplashLayout.astro";
import Badge from "../components/content/Badge.astro";
import Card from "../components/content/Card.astro";
import CardGrid from "../components/content/CardGrid.astro";
import Steps from "../components/content/Steps.astro";
import FileTree from "../components/content/FileTree.astro";
import Aside from "../components/content/Aside.astro";
import Lede from "../components/content/Lede.astro";
import ExternalLink from "../components/content/ExternalLink.astro";
import Icon from "../components/Icon.astro";

// provided to every mdx page so content can use <Steps>/<Card>/<Aside>/… without importing
const mdxComponents = {
  Badge,
  Card,
  CardGrid,
  Steps,
  FileTree,
  Aside,
  Lede,
  ExternalLink,
  Icon,
};

export async function getStaticPaths() {
  const docs = await getCollection("docs", ({ data }) => !data.draft);
  return docs.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, template, tableOfContents, prev, next, hero } =
  entry.data;
const currentPath = Astro.url.pathname;
---

{
  template === "splash" ? (
    <SplashLayout title={title} description={description} hero={hero}>
      <Content components={mdxComponents} />
    </SplashLayout>
  ) : (
    <DocsLayout
      id={entry.id}
      title={title}
      description={description}
      headings={headings}
      currentPath={currentPath}
      tableOfContents={tableOfContents}
      prev={prev}
      next={next}
      hero={hero}
    >
      <Content components={mdxComponents} />
    </DocsLayout>
  )
}
